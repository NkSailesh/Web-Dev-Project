<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="w-full h-full bg-red-600">
    <h1 class="  text-2xl font-bold w-full bg-white rounded " >server is on    </h1>

    <div class=" mt-2 mr-6 ml-5 pl-2 pr-5 flex  justify-between items-center bg-white rounded">
        <img class=" h-12 w-12 rounded " src="/Image/Logo.gif" alt="LOGO">
        <a href="/">Home</a>
        <div class=" flex  justify-between items-center  ">
                <input class=" border-2 mr-1 round-r-1 rounded-l-3xl" type="text" placeholder="Book name/ISBN-NO">
                <a class=" border-1  h-7 w-12 " href="">Search</a>
        </div>
        <div>
            <a href="/">Add New Book</a>
        </div>
        <div class="flex flex-wrap gap-9">
               <a class=" font-bold" href="">Cart</a>
                <p class=" text-black font-sans font-bold">Open Library</p>
        </div>
       
        

    </div>

<!-- book start here -->
  
   <% if(users.length>0){ %>
     <% users.forEach(function(user){ %>
        <div class="mt-10 mb-2 ml-20 mr-6 ">
          <div class="   flex font-bold text-gray-700  ">
            <img class=" h-60 w-40 bg-white" src="/Data/<%= user.Bookimage %>" alt="ImageBook">
             <a href=""></a>  
            <div class="grid grid-cols-4 gap-9 ml-10">     
                        <section>
                            <p>Title</p>
                            <p class=" text-white"> <%= user.BookName %> </p>
                        </section>
                        <section>
                            <p>Authors name</p>
                            <p class=" text-white "> <%= user.AuthorsName %></p>
                        </section>
                        
                       <section>
                         <a href=""> Eshop-Platform</a>
                        <p class="text-white">Amazon</p>
                       </section>                 
                       

                            <section>
                                
                                 <a class=" border-2" href="/cart"> AddtoCart </a>
                               
                            </section>
                        <section>
                            <p>Print lrngth</p> 
                            <p class="text-white"><%= user.PrintLength %></p>
                         
                        </section>
                        <section>
                            <p>Publisher </p>
                            <p class="text-white"><%= user.Publisher %></p>
                            </section>
                        <section>
                            <p>Publication Date</p>
                            <p class="text-white"><%= user.PublicationDate %></p>
                        </section>
                        <section>
                            <p>Language</p>
                            <p class="text-white"><%= user.Language %></p>
                        </section>
                        <section>
                            <p>Download Book</p>
                            <a class=" text-white" href="/Data/<%= user.BookPdf %>"><%= user.BookPdf%></a>
                           
                            
                        </section> 
                        <section>
                               <p>ISBN-NO-10</p>
                               <p class="text-white"><%= user.Isbn10 %></p>
                        </section>
                        <section>
                               <p>ISBN-NO-13</p>
                               <p class="text-white"><%= user.Isbn13  %></p>
                        </section>  
                        <section>
                               <p>Edition</p>
                               <p class="text-white"><%= user.Edition %></p>
                        </section> 
                        <section class="flex flex-wrap gap-7">
                               <a href="/delete/<%= user._id %>">Delete From Library</a>
                               <a href="/edit/<%= user._id %>">Edit</a>
                        </section> 
                 </div> 
         </div>
    </div>
         <% }) %>
    <% } else{%>
        <h3>No Books Avilable</h3>
   <% } %>
         
    
    
</body>
</html>




